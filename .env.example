# Local ADK Web development with Google AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_API_KEY=replace-me

# Optional Gemini Live settings. Defaults are shown.
# MORTGAGE_GEMINI_LIVE_MODEL=gemini-3.8-live
# MORTGAGE_VOICE=Kore
# Model for the background request team and document captions.
# MORTGAGE_REQUEST_MODEL=gemini-3.8-flash
# Optional comma-separated names or terms to help speech recognition.
# MORTGAGE_TRANSCRIPTION_VOCABULARY=Example Name,Example Surname

# Optional Live Avatar. Uses Google Cloud ADC for the live connection only.
# Keep GOOGLE_API_KEY for the request workflow and document captions.
# Run: gcloud auth application-default login
# MORTGAGE_AVATAR_NAME=Kira
# MORTGAGE_AVATAR_PROJECT=your-project-id
# MORTGAGE_AVATAR_LOCATION=us-central1
# MORTGAGE_AVATAR_VOICE=Kore
# Custom appearance requires Google Cloud allowlisting. Supply your own PNG
# under 5 MB, at least 704 x 1280 pixels. Overrides MORTGAGE_AVATAR_NAME.
# MORTGAGE_AVATAR_IMAGE=/path/to/your/avatar.png

# Optional Vertex AI settings for future Agent Platform work.
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
